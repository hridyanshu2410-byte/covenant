#version 450
// combine the two chains into the final image
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D bloom;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D lum;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D base;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outImg;
void main() {
  ivec2 q = ivec2(gl_GlobalInvocationID.xy);
  ivec2 sz = imageSize(outImg);
  if (q.x >= sz.x || q.y >= sz.y) return;
  vec4 b = imageLoad(bloom, q * imageSize(bloom) / sz);
  vec4 l = imageLoad(lum, ivec2(0));
  vec4 s = imageLoad(base, q * imageSize(base) / sz);
  vec3 c = (s.rgb + b.rgb) / (1.0 + l.r + l.g);
  imageStore(outImg, q, vec4(c / (1.0 + c), 1.0));
}
