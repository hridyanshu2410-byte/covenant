#version 450
// turn the histogram into an image
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) readonly buffer Hist { uint h[]; } hist;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  ivec2 sz = imageSize(outImg);
  if (p.x >= sz.x || p.y >= sz.y) return;
  uvec2 b = uvec2(p * 64 / sz);
  float c = float(hist.h[b.y * 64u + b.x]);
  imageStore(outImg, p, vec4(fract(c * 0.013), fract(c * 0.0071), fract(c * 0.0031), 1.0));
}
