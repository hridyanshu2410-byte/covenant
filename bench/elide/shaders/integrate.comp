#version 450
// one particle system: integrate positions in place
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Particles { vec4 p[]; } parts;
layout(push_constant) uniform PC { uint n; uint frame; uint sys; uint iters; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  vec4 v = parts.p[i];
  if (pc.frame == 0u) {
    float t = float(i) * 0.6180339 + float(pc.sys) * 1.37;
    v = vec4(fract(t), fract(t * 1.7), fract(t * 2.3), 0.0);
  }
  for (uint k = 0u; k < pc.iters; k++) {
    v.xy = fract(v.xy + 0.01 * vec2(sin(v.y * 6.2831853 + float(pc.sys)), cos(v.x * 6.2831853)));
    v.z = fract(v.z + 0.013 * v.x);
  }
  v.w += 1.0;
  parts.p[i] = v;
}
