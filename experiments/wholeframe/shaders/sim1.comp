#version 450
// W1: writes the shared particle buffer from the per-frame uniform.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform U { vec4 t; } u;
layout(set = 0, binding = 1) writeonly buffer Out { vec4 p[]; } o;
void main() {
  uint i = gl_GlobalInvocationID.x;
  float a = u.t.x + float(i) * 0.1;
  o.p[i] = vec4(0.5 * cos(a), 0.5 * sin(a), 0.0, 1.0);
}
