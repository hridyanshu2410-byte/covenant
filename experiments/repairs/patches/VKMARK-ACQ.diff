diff --git a/src/ws/swapchain_window_system.cpp b/src/ws/swapchain_window_system.cpp
index 9f9fba3..e9ff76e 100644
--- a/src/ws/swapchain_window_system.cpp
+++ b/src/ws/swapchain_window_system.cpp
@@ -139,25 +139,42 @@ void SwapchainWindowSystem::init_vulkan(VulkanState& vulkan_)
     Log::debug("SwapchainWindowSystem: Swapchain contains %d images\n",
                vk_images.size());
 
-    vk_acquire_semaphore = ManagedResource<vk::Semaphore>{
-        vulkan->device().createSemaphore(vk::SemaphoreCreateInfo()),
-        [this] (auto& s) { vulkan->device().destroySemaphore(s); }};
+    // One acquire semaphore per frame slot, reused only after the submission that
+    // waited on it has completed (its fence).
+    for (uint32_t i = 0; i < vk_images.size(); ++i)
+    {
+        vk_acquire_semaphores.push_back(ManagedResource<vk::Semaphore>{
+            vulkan->device().createSemaphore(vk::SemaphoreCreateInfo()),
+            [this] (auto& s) { vulkan->device().destroySemaphore(s); }});
+        vk_submit_fences.push_back(ManagedResource<vk::Fence>{
+            vulkan->device().createFence(vk::FenceCreateInfo{vk::FenceCreateFlagBits::eSignaled}),
+            [this] (auto& f) { vulkan->device().destroyFence(f); }});
+    }
+    current_slot = 0;
 }
 
 void SwapchainWindowSystem::deinit_vulkan()
 {
     vulkan->device().waitIdle();
-    vk_acquire_semaphore = {};
+    vk_acquire_semaphores.clear();
+    vk_submit_fences.clear();
     vk_swapchain = {};
     vk_surface = {};
 }
 
 VulkanImage SwapchainWindowSystem::next_vulkan_image()
 {
+    auto const slot = current_slot;
+    current_slot = (current_slot + 1) % vk_acquire_semaphores.size();
+
+    (void)vulkan->device().waitForFences(vk_submit_fences[slot].raw, true, INT64_MAX);
+    vulkan->device().resetFences(vk_submit_fences[slot].raw);
+
     auto const image_index = vulkan->device().acquireNextImageKHR(
-        vk_swapchain, UINT64_MAX, vk_acquire_semaphore, nullptr).value;
+        vk_swapchain, UINT64_MAX, vk_acquire_semaphores[slot], nullptr).value;
 
-    return {image_index, vk_images[image_index], vk_image_format, vk_extent, vk_acquire_semaphore};
+    return {image_index, vk_images[image_index], vk_image_format, vk_extent,
+            vk_acquire_semaphores[slot], vk_submit_fences[slot], slot};
 }
 
 void SwapchainWindowSystem::present_vulkan_image(VulkanImage const& vulkan_image)
