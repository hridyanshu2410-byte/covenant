Case:     VKMARK-UBO
Project:  vkmark
Upstream: https://github.com/vkmark/vkmark
Revision: ab6e6f3
Paths:    relative to the source root
Files:    10 changed, +45/-5
          src/scenes/cube_scene.cpp
          src/scenes/cube_scene.h
          src/scenes/desktop_scene.cpp
          src/scenes/desktop_scene.h
          src/scenes/shading_scene.cpp
          src/scenes/shading_scene.h
          src/scenes/texture_scene.cpp
          src/scenes/texture_scene.h
          src/scenes/vertex_scene.cpp
          src/scenes/vertex_scene.h
Cause:    each scene rewrites its uniform buffer in mapped memory every frame while the previous frame's draw may still read it (host write vs. device read)
Repair:   each scene gets one fence, created signalled; draw() waits for and resets it before updating the uniforms, and the submit signals it
Apply:    git apply VKMARK-UBO.diff   (from the source root; this header is ignored by git apply)

diff --git a/src/scenes/cube_scene.cpp b/src/scenes/cube_scene.cpp
index 9fb7e95..87e9c80 100644
--- a/src/scenes/cube_scene.cpp
+++ b/src/scenes/cube_scene.cpp
@@ -79,6 +79,9 @@ void CubeScene::setup(
     setup_command_buffers();
 
     submit_semaphore = vkutil::SemaphoreBuilder{*vulkan}.build();
+    submit_fence = ManagedResource<vk::Fence>{
+        vulkan->device().createFence(vk::FenceCreateInfo{vk::FenceCreateFlagBits::eSignaled}),
+        [this] (auto& f) { vulkan->device().destroyFence(f); }};
     rotation = {45.0f, 45.0f, 10.0f};
 }
 
@@ -87,6 +90,7 @@ void CubeScene::teardown()
     vulkan->device().waitIdle();
 
     submit_semaphore = {};
+    submit_fence = {};
     vulkan->device().freeCommandBuffers(vulkan->command_pool(), command_buffers);
     framebuffers.clear();
     image_views.clear();
@@ -103,6 +107,9 @@ void CubeScene::teardown()
 
 VulkanImage CubeScene::draw(VulkanImage const& image)
 {
+    // The previous frame may still read the uniform buffer: wait before rewriting it.
+    (void)vulkan->device().waitForFences(submit_fence.raw, true, INT64_MAX);
+    vulkan->device().resetFences(submit_fence.raw);
     update_uniforms();
 
     vk::PipelineStageFlags const mask = vk::PipelineStageFlagBits::eTopOfPipe;
@@ -115,7 +122,7 @@ VulkanImage CubeScene::draw(VulkanImage const& image)
         .setSignalSemaphoreCount(1)
         .setPSignalSemaphores(&submit_semaphore.raw);
 
-    vulkan->graphics_queue().submit(submit_info, {});
+    vulkan->graphics_queue().submit(submit_info, submit_fence);
 
     return image.copy_with_semaphore(submit_semaphore);
 }
